{
  "name": "visit-reminders",
  "version": "1.0.0",
  "private": true,
  "description": "Local countdown reminders for timers on pages you already open.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "safety:audit": "node scripts/safety-audit.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run safety:audit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
